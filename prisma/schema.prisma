generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Enums ----------

enum Role {
  ADMIN
  MANAGER
  AGENT
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum ConversationSource {
  WHATSAPP
  MOCK
  MANUAL
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  LINK
  TEMPLATE
}

enum MessageStatus {
  ACCEPTED
  UNKNOWN
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum ConsentStatus {
  UNKNOWN
  OPTED_IN
  OPTED_OUT
}

enum TemplateStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum AutomationTrigger {
  NEW_INBOUND_MESSAGE
  NEW_CONVERSATION
  TAG_ADDED
  CONVERSATION_UNASSIGNED
  NO_REPLY_TIMEOUT
}

enum AutomationActionType {
  ASSIGN_AGENT
  ADD_TAG
  CHANGE_STATUS
  ADD_INTERNAL_NOTE
  SEND_CANNED_REPLY
  SEND_TEMPLATE
}

enum AutomationRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// ---------- Models ----------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(AGENT)
  teamId       String?
  team         Team?    @relation(fields: [teamId], references: [id])
  isActive     Boolean  @default(true)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campaigns             Campaign[]
  assignedConversations Conversation[]      @relation("AssignedAgent")
  messagesSent          Message[]           @relation("SentByUser")
  notes                 Note[]
  auditLogs             AuditLog[]
  drafts                ConversationDraft[]
  cannedReplies         CannedReply[]       @relation("CreatedByUser")
}

model Team {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  members   User[]
}

model Contact {
  isBlocked Boolean @default(false)
  consentAt DateTime?
  consentSource String?
  consentEvidence String?
  consentScope String?
  lastMarketingAt DateTime?
  id             String               @id @default(cuid())
  name           String
  phone          String               @unique
  email          String?
  tags           ContactTag[]
  source         String?
  consentStatus  ConsentStatus        @default(UNKNOWN)
  listMemberships DistributionListMember[]
  campaignRecipients CampaignRecipient[]
  customFields   ContactCustomField[]
  notes          Note[]
  conversations  Conversation[]
  createdAt      DateTime             @default(now())
  lastActivityAt DateTime?
  updatedAt      DateTime             @updatedAt

  @@index([phone])
  @@index([name])
}

model ContactCustomField {
  id        String  @id @default(cuid())
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  key       String
  value     String

  @@unique([contactId, key])
}

model Conversation {
  sendLockToken String?
  sendLockUntil DateTime?
  id              String              @id @default(cuid())
  contactId       String
  contact         Contact             @relation(fields: [contactId], references: [id])
  assignedAgentId String?
  assignedAgent   User?               @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  status          ConversationStatus  @default(OPEN)
  source          ConversationSource  @default(MOCK)
  isSpam          Boolean             @default(false)
  lastMessageAt   DateTime?
  lastInboundAt   DateTime?
  unreadCount     Int                 @default(0)
  messages        Message[]
  tags            ConversationTag[]
  notes           Note[]
  drafts          ConversationDraft[]
  automationRuns  AutomationRun[]
  auditLogs       AuditLog[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status])
  @@index([assignedAgentId])
  @@index([lastMessageAt])
}

model Message {
  requestKey String? @unique
  providerCredentialId String?
  errorReason String?
  acceptedAt DateTime?
  sentAt DateTime?
  failedAt DateTime?
  id                String              @id @default(cuid())
  conversationId    String
  conversation      Conversation        @relation(fields: [conversationId], references: [id])
  direction         MessageDirection
  type              MessageType
  body              String?
  status            MessageStatus       @default(SENT)
  sentByUserId      String?
  sentByUser        User?               @relation("SentByUser", fields: [sentByUserId], references: [id])
  attachments       MessageAttachment[]
  templateId        String?
  template          Template?           @relation(fields: [templateId], references: [id])
  inboundKey        String?             @unique
  providerMessageId String?
  deliveredAt       DateTime?
  readAt            DateTime?
  createdAt         DateTime            @default(now())

  @@index([conversationId, createdAt])
  @@index([providerMessageId])
}

model MessageAttachment {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  url       String
  providerMediaId String?
  mimeType  String
  fileName  String?
  sizeBytes Int?
  createdAt DateTime @default(now())
}

model Tag {
  id            String            @id @default(cuid())
  name          String            @unique
  color         String            @default("#6366f1")
  contacts      ContactTag[]
  conversations ConversationTag[]
  createdAt     DateTime          @default(now())
}

model ContactTag {
  contactId String
  tagId     String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

model ConversationTag {
  conversationId String
  tagId          String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag            Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([conversationId, tagId])
}

model Note {
  id               String        @id @default(cuid())
  conversationId   String?
  conversation     Conversation? @relation(fields: [conversationId], references: [id])
  contactId        String?
  contact          Contact?      @relation(fields: [contactId], references: [id])
  authorId         String
  author           User          @relation(fields: [authorId], references: [id])
  body             String
  mentionedUserIds String[]      @default([])
  createdAt        DateTime      @default(now())
}

model ConversationDraft {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  body           String
  updatedAt      DateTime     @updatedAt

  @@unique([conversationId, userId])
}

model CannedReply {
  id              String   @id @default(cuid())
  title           String
  body            String
  shortcut        String?  @unique
  createdByUserId String
  createdByUser   User     @relation("CreatedByUser", fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())
}

model Template {
  id        String           @id @default(cuid())
  name      String
  language  String           @default("he")
  category  TemplateCategory @default(UTILITY)
  providerTemplateId String? @unique
  providerAccountId String?
  syncError String?
  body      String
  variables String[]         @default([])
  status    TemplateStatus   @default(DRAFT)
  messages  Message[]
  campaigns Campaign[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([name, language])
  @@index([providerAccountId])
}

model AutomationRule {
  id            String               @id @default(cuid())
  name          String
  isActive      Boolean              @default(true)
  trigger       AutomationTrigger
  triggerConfig Json                 @default("{}")
  actionType    AutomationActionType
  actionConfig  Json                 @default("{}")
  runs          AutomationRun[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model AutomationRun {
  id             String              @id @default(cuid())
  ruleId         String
  rule           AutomationRule      @relation(fields: [ruleId], references: [id])
  conversationId String?
  conversation   Conversation?       @relation(fields: [conversationId], references: [id])
  status         AutomationRunStatus @default(PENDING)
  scheduledFor   DateTime            @default(now())
  triggerPayload Json                @default("{}")
  result         Json?
  error          String?
  attempts       Int                 @default(0)
  createdAt      DateTime            @default(now())
  completedAt    DateTime?

  @@index([status, scheduledFor])
}

model AuditLog {
  id             String        @id @default(cuid())
  actorUserId    String?
  actorUser      User?         @relation(fields: [actorUserId], references: [id])
  action         String
  entityType     String
  entityId       String
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now())

  @@index([entityType, entityId])
}

model ProviderCredential {
  lastCheckedAt DateTime?
  lastConnectionError String?
  sendingBlocked Boolean @default(false)
  id        String   @id @default(cuid())
  provider  String
  isActive  Boolean  @default(false)
  config    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum RecipientStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
  SKIPPED
  UNKNOWN
}

model DistributionList {
  id        String @id @default(cuid())
  name      String
  members   DistributionListMember[]
  campaigns Campaign[]
  createdAt DateTime @default(now())
}

model DistributionListMember {
  listId    String
  contactId String
  list      DistributionList @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([listId, contactId])
  @@index([contactId])
}

model Campaign {
  senderSnapshot String?
  templateSnapshot String?
  id          String @id @default(cuid())
  name        String
  listId      String
  list        DistributionList @relation(fields: [listId], references: [id])
  templateId  String
  template    Template @relation(fields: [templateId], references: [id])
  variables   Json @default("{}")
  createdById String
  createdBy   User @relation(fields: [createdById], references: [id])
  status      CampaignStatus @default(DRAFT)
  scheduledAt DateTime?
  recipients  CampaignRecipient[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, scheduledAt])
  @@index([listId])
  @@index([templateId])
  @@index([createdById])
}

model CampaignRecipient {
  id          String @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId   String
  contact     Contact @relation(fields: [contactId], references: [id])
  status      RecipientStatus @default(QUEUED)
  messageId   String? @unique
  error       String?
  claimedAt   DateTime?
  completedAt DateTime?

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@index([status, claimedAt])
  @@index([contactId])
}

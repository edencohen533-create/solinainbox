generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Enums ----------

enum Role {
  ADMIN
  MANAGER
  AGENT
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum ConversationSource {
  WHATSAPP
  MOCK
  MANUAL
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  LINK
  TEMPLATE
}

enum MessageStatus {
  ACCEPTED
  UNKNOWN
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum ConsentStatus {
  UNKNOWN
  OPTED_IN
  OPTED_OUT
}

enum TemplateStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum AutomationTrigger {
  NEW_INBOUND_MESSAGE
  NEW_CONVERSATION
  TAG_ADDED
  CONVERSATION_UNASSIGNED
  NO_REPLY_TIMEOUT
}

enum AutomationActionType {
  ASSIGN_AGENT
  ADD_TAG
  CHANGE_STATUS
  ADD_INTERNAL_NOTE
  SEND_CANNED_REPLY
  SEND_TEMPLATE
}

enum AutomationRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// ---------- Models ----------

model User {
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "User_organization_fk")
  organizationId String       @default(dbgenerated("COALESCE(NULLIF(current_setting('solina.organization_id', true), ''), 'legacy')"))
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  name           String
  role           Role         @default(AGENT)
  teamId         String?
  team           Team?        @relation(fields: [teamId], references: [id])
  isActive       Boolean      @default(true)
  avatarUrl      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  campaigns             Campaign[]
  assignedConversations Conversation[]      @relation("AssignedAgent")
  messagesSent          Message[]           @relation("SentByUser")
  notes                 Note[]
  auditLogs             AuditLog[]
  drafts                ConversationDraft[]
  cannedReplies         CannedReply[]       @relation("CreatedByUser")

  @@index([organizationId])
}

model Team {
  whatsappNumbers ProviderCredential[]
  organizationId  String               @default(dbgenerated("COALESCE(NULLIF(current_setting('solina.organization_id', true), ''), 'legacy')"))
  id              String               @id @default(cuid())
  name            String
  createdAt       DateTime             @default(now())
  members         User[]

  @@index([organizationId])
}

model Contact {
  organizationId     String                   @default(dbgenerated("COALESCE(NULLIF(current_setting('solina.organization_id', true), ''), 'legacy')"))
  isBlocked          Boolean                  @default(false)
  consentAt          DateTime?
  consentSource      String?
  consentEvidence    String?
  consentScope       String?
  lastMarketingAt    DateTime?
  id                 String                   @id @default(cuid())
  name               String
  phone              String
  email              String?
  tags               ContactTag[]
  source             String?
  consentStatus      ConsentStatus            @default(UNKNOWN)
  listMemberships    DistributionListMember[]
  campaignRecipients CampaignRecipient[]
  customFields       ContactCustomField[]
  notes              Note[]
  conversations      Conversation[]
  createdAt          DateTime                 @default(now())
  lastActivityAt     DateTime?
  updatedAt          DateTime                 @updatedAt

  @@unique([organizationId, phone])
  @@index([phone])
  @@index([name])
  @@index([organizationId])
}

model ContactCustomField {
  organizationId String  @default(dbgenerated("COALESCE(NULLIF(current_setting('solina.organization_id', true), ''), 'legacy')"))
  id             String  @id @default(cuid())
  contactId      String
  contact        Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  key            String
  value          String

  @@unique([contactId, key])
  @@index([organizationId])
}

model Conversation {
  providerCredentialId String?
  providerCredential   ProviderCredential? @relation(fields: [providerCredentialId], references: [id], onDelete: Restrict)
  organizationId       String              @default(dbgenerated("COALESCE(NULLIF(current_setting('solina.organization_id', true), ''), 'legacy')"))
  sendLockToken        String?
  sendLockUntil        DateTime?
  id                   String              @id @default(cuid())
  contactId            String
  contact              Contact             @relation(fields: [contactId], references: [id])
  assignedAgentId      String?
  assignedAgent        User?               @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  status               ConversationStatus  @default(OPEN)
  source               ConversationSource  @default(MOCK)
  isSpam               Boolean             @default(false)
  lastMessageAt        DateTime?
  lastInboundAt        DateTime?
  unreadCount          Int                 @default(0)
  messages             Message[]
  tags                 ConversationTag[]
  notes                Note[]
  drafts               ConversationDraft[]
  automationRuns       AutomationRun[]
  auditLogs            AuditLog[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([providerCredentialId])
  @@index([status])
  @@index([assignedAgentId])
  @@index([lastMessageAt])
  @@index([organizationId])
}

model Message {
  organizationId       String              @default(dbgenerated("COALESCE(NULLIF(current_setting('solina.organization_id', true), ''), 'legacy')"))
  requestKey           String?             @unique
  providerCredentialId String?
  errorReason          String?
  acceptedAt           DateTime?
  sentAt               DateTime?
  failedAt             DateTime?
  id                   String              @id @default(cuid())
  conversationId       String
  conversation         Conversation        @relation(fields: [conversationId], references: [id])
  direction            MessageDirection
  type                 MessageType
  body                 String?
  status               MessageStatus       @default(SENT)
  sentByUserId         String?
  sentByUser           User?               @relation("SentByUser", fields: [sentByUserId], references: [id])
  attachments          MessageAttachment[]
  templateId           String?
  template             Template?           @relation(fields: [templateId], references: [id])
  inboundKey           String?             @unique
  providerMessageId    String?
  deliveredAt          DateTime?
  readAt               DateTime?
  createdAt            DateTime            @default(now())

  @@index([conversationId, createdAt])
  @@index([providerMessageId])
  @@index([organizationId])
}

model MessageAttachment {
  organizationId  String   @default(dbgenerated("COALESCE(NULLIF(current_setting('solina.organization_id', true), ''), 'legacy')"))
  id              String   @id @default(cuid())
  messageId       String
  message         Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  url             String
  providerMediaId String?
  mimeType        String
  fileName        String?
  sizeBytes       Int?
  createdAt       DateTime @default(now())

  @@index([organizationId])
}

model Tag {
  organizationId String            @default(dbgenerated("COALESCE(NULLIF(current_setting('solina.organization_id', true), ''), 'legacy')"))
  id             String            @id @default(cuid())
  name           String
  color          String            @default("#6366f1")
  contacts       ContactTag[]
  conversations  ConversationTag[]
  createdAt      DateTime          @default(now())

  @@unique([organizationId, name])
  @@index([organizationId])
}

model ContactTag {
  organizationId String  @default(dbgenerated("COALESCE(NULLIF(current_setting('solina.organization_id', true), ''), 'legacy')"))
  contactId      String
  tagId          String
  contact        Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag            Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([organizationId])
}

model ConversationTag {
  organizationId String       @default(dbgenerated("COALESCE(NULLIF(current_setting('solina.organization_id', true), ''), 'legacy')"))
  conversationId String
  tagId          String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag            Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([conversationId, tagId])
  @@index([organizationId])
}

model Note {
  organizationId   String        @default(dbgenerated("COALESCE(NULLIF(current_setting('solina.organization_id', true), ''), 'legacy')"))
  id               String        @id @default(cuid())
  conversationId   String?
  conversation     Conversation? @relation(fields: [conversationId], references: [id])
  contactId        String?
  contact          Contact?      @relation(fields: [contactId], references: [id])
  authorId         String
  author           User          @relation(fields: [authorId], references: [id])
  body             String
  mentionedUserIds String[]      @default([])
  createdAt        DateTime      @default(now())

  @@index([organizationId])
}

model ConversationDraft {
  organizationId String       @default(dbgenerated("COALESCE(NULLIF(current_setting('solina.organization_id', true), ''), 'legacy')"))
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  body           String
  updatedAt      DateTime     @updatedAt

  @@unique([conversationId, userId])
  @@index([organizationId])
}

model CannedReply {
  organizationId  String   @default(dbgenerated("COALESCE(NULLIF(current_setting('solina.organization_id', true), ''), 'legacy')"))
  id              String   @id @default(cuid())
  title           String
  body            String
  shortcut        String?
  createdByUserId String
  createdByUser   User     @relation("CreatedByUser", fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())

  @@unique([organizationId, shortcut])
  @@index([organizationId])
}

model Template {
  organizationId     String           @default(dbgenerated("COALESCE(NULLIF(current_setting('solina.organization_id', true), ''), 'legacy')"))
  id                 String           @id @default(cuid())
  name               String
  language           String           @default("he")
  category           TemplateCategory @default(UTILITY)
  providerTemplateId String?          @unique
  providerAccountId  String?
  syncError          String?
  body               String
  variables          String[]         @default([])
  status             TemplateStatus   @default(DRAFT)
  messages           Message[]
  campaigns          Campaign[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([organizationId, name, language])
  @@index([providerAccountId])
  @@index([organizationId])
}

model AutomationRule {
  organizationId String               @default(dbgenerated("COALESCE(NULLIF(current_setting('solina.organization_id', true), ''), 'legacy')"))
  id             String               @id @default(cuid())
  name           String
  isActive       Boolean              @default(true)
  trigger        AutomationTrigger
  triggerConfig  Json                 @default("{}")
  actionType     AutomationActionType
  actionConfig   Json                 @default("{}")
  runs           AutomationRun[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([organizationId])
}

model AutomationRun {
  organizationId String              @default(dbgenerated("COALESCE(NULLIF(current_setting('solina.organization_id', true), ''), 'legacy')"))
  id             String              @id @default(cuid())
  ruleId         String
  rule           AutomationRule      @relation(fields: [ruleId], references: [id])
  conversationId String?
  conversation   Conversation?       @relation(fields: [conversationId], references: [id])
  status         AutomationRunStatus @default(PENDING)
  scheduledFor   DateTime            @default(now())
  triggerPayload Json                @default("{}")
  result         Json?
  error          String?
  attempts       Int                 @default(0)
  createdAt      DateTime            @default(now())
  completedAt    DateTime?

  @@index([status, scheduledFor])
  @@index([organizationId])
}

model AuditLog {
  organizationId String        @default(dbgenerated("COALESCE(NULLIF(current_setting('solina.organization_id', true), ''), 'legacy')"))
  id             String        @id @default(cuid())
  actorUserId    String?
  actorUser      User?         @relation(fields: [actorUserId], references: [id])
  action         String
  entityType     String
  entityId       String
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now())

  @@index([entityType, entityId])
  @@index([organizationId])
}

model ProviderCredential {
  label               String?
  displayPhoneNumber  String?
  teamId              String?
  team                Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  isDefault           Boolean        @default(false)
  lastWebhookAt       DateTime?
  conversations       Conversation[]
  campaigns           Campaign[]
  phoneNumberId       String?        @unique
  organizationId      String         @default(dbgenerated("COALESCE(NULLIF(current_setting('solina.organization_id', true), ''), 'legacy')"))
  lastCheckedAt       DateTime?
  lastConnectionError String?
  sendingBlocked      Boolean        @default(false)
  id                  String         @id @default(cuid())
  provider            String
  isActive            Boolean        @default(false)
  config              Json           @default("{}")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([organizationId])
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum RecipientStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
  SKIPPED
  UNKNOWN
}

model DistributionList {
  organizationId String                   @default(dbgenerated("COALESCE(NULLIF(current_setting('solina.organization_id', true), ''), 'legacy')"))
  id             String                   @id @default(cuid())
  name           String
  members        DistributionListMember[]
  campaigns      Campaign[]
  createdAt      DateTime                 @default(now())

  @@index([organizationId])
}

model DistributionListMember {
  organizationId String           @default(dbgenerated("COALESCE(NULLIF(current_setting('solina.organization_id', true), ''), 'legacy')"))
  listId         String
  contactId      String
  list           DistributionList @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact        Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([listId, contactId])
  @@index([contactId])
  @@index([organizationId])
}

model Campaign {
  providerCredentialId String?
  providerCredential   ProviderCredential? @relation(fields: [providerCredentialId], references: [id], onDelete: Restrict)
  organizationId       String              @default(dbgenerated("COALESCE(NULLIF(current_setting('solina.organization_id', true), ''), 'legacy')"))
  senderSnapshot       String?
  templateSnapshot     String?
  id                   String              @id @default(cuid())
  name                 String
  listId               String
  list                 DistributionList    @relation(fields: [listId], references: [id])
  templateId           String
  template             Template            @relation(fields: [templateId], references: [id])
  variables            Json                @default("{}")
  createdById          String
  createdBy            User                @relation(fields: [createdById], references: [id])
  status               CampaignStatus      @default(DRAFT)
  scheduledAt          DateTime?
  recipients           CampaignRecipient[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([providerCredentialId])
  @@index([status, scheduledAt])
  @@index([listId])
  @@index([templateId])
  @@index([createdById])
  @@index([organizationId])
}

model CampaignRecipient {
  organizationId String          @default(dbgenerated("COALESCE(NULLIF(current_setting('solina.organization_id', true), ''), 'legacy')"))
  id             String          @id @default(cuid())
  campaignId     String
  campaign       Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact         @relation(fields: [contactId], references: [id])
  status         RecipientStatus @default(QUEUED)
  messageId      String?         @unique
  error          String?
  claimedAt      DateTime?
  completedAt    DateTime?

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@index([status, claimedAt])
  @@index([contactId])
  @@index([organizationId])
}

// Workspace membership is server-managed; clients cannot choose their tenant.
model Organization {
  users                User[]
  id                   String    @id @default(cuid())
  name                 String
  isActive             Boolean   @default(true)
  lastCampaignScanAt   DateTime?
  lastAutomationScanAt DateTime?
  createdAt            DateTime  @default(now())
}
